# ---------------------------------------------------------------------------
# Copia este archivo como `.env` para desarrollo local.
# En Vercel, define estas mismas variables en Settings → Environment Variables.
# ---------------------------------------------------------------------------

# URL pública del sitio (para enlaces compartidos, OAuth y metadatos OG).
# En local apunta al servidor de Vite; en Vercel se detecta sola si no la defines.
SITE_URL=http://localhost:5173

# --- Base de datos --------------------------------------------------------
# Neon Postgres (Vercel Marketplace → Neon → Connect). Usa la cadena "pooled".
# Si la dejas vacía, en local se usa SQLite (backend/patitas.db) automáticamente.
DATABASE_URL=

# Crea/verifica las tablas al arrancar. Ponlo en 0 cuando la base ya esté migrada
# para ahorrar unos milisegundos en cada arranque en frío.
AUTO_CREATE_TABLES=1

# --- Sesiones -------------------------------------------------------------
# Obligatorio en producción. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=43200

# --- Google OAuth (opcional) ---------------------------------------------
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Almacenamiento de fotos ---------------------------------------------
# Vercel → Storage → Blob. Si está vacío, las fotos se guardan en backend/uploads
# (solo sirve en local: el disco de las funciones serverless es efímero).
BLOB_READ_WRITE_TOKEN=

MAX_PHOTOS=5
MAX_UPLOAD_BYTES=6291456

# --- Administradores ------------------------------------------------------
# Estos correos reciben rol de administrador al registrarse (separados por coma).
ADMIN_EMAILS=

# --- Antispam opcional (Cloudflare Turnstile) ----------------------------
# Si defines el secreto, la API exigirá captcha al publicar y al reportar.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- Ingesta de noticias (Vercel Cron) -----------------------------------
# Protege /api/cron/news para que solo Vercel pueda dispararla. OBLIGATORIO en
# producción: sin esto la ruta queda abierta a cualquiera. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# En Vercel, además, define la misma variable en Settings → Environment Variables:
# la plataforma la envía sola como cabecera Authorization al ejecutar el cron.
CRON_SECRET=

# --- Alerta al publicar (opcional) ---------------------------------------
# Aviso cada vez que alguien crea una publicación. Si no configuras ninguna de
# estas opciones no se envía nada y publicar funciona igual.
#
# OPCIÓN RECOMENDADA: Telegram. Es gratis, oficial, no caduca y no exige
# aprobar plantillas como WhatsApp.
#
#   1. En Telegram busca @BotFather y envíale /newbot
#   2. Elige un nombre y un usuario que termine en "bot". Te da el token.
#   3. Busca tu bot por ese usuario y escríbele /start (importante: el bot no
#      puede escribirte primero si tú nunca le hablaste).
#   4. Con el token ya puesto aquí abajo, ejecuta desde la raíz del proyecto:
#        .\.venv\Scripts\python.exe -m backend.app.notify --telegram-chats
#      Te imprime el TELEGRAM_CHAT_ID listo para copiar.
#   5. Comprueba que todo quedó bien con:
#        .\.venv\Scripts\python.exe -m backend.app.notify --test
#
# Para que las alertas lleguen a varias personas, crea un grupo, mete al bot y
# usa el id del grupo (es negativo, algo como -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alternativas por WhatsApp (opcionales) ------------------------------
# Solo se usan si no hay Telegram configurado.
# Número destino en formato internacional y sin signos (57 + número).
ALERT_WHATSAPP_TO=

# Opción A — CallMeBot (gratis, servicio de terceros sin garantías).
#   1. Agrega a tus contactos el número del bot: +34 644 87 21 57
#      OJO: este número cambia cada cierto tiempo. Si no responde, confirma el
#      vigente en https://www.callmebot.com/blog/free-api-whatsapp-messages/
#   2. Envíale por WhatsApp el texto exacto, en inglés y sin cambiar nada:
#        I allow callmebot to send me messages
#   3. Responde con "API Activated for your phone number. Your APIKEY is ..."
#      Si no contesta en dos minutos, mándale: Recover APIKey
CALLMEBOT_APIKEY=

# Opción B — WhatsApp Cloud API de Meta (oficial). Ojo: fuera de la ventana de
# 24 horas solo se pueden enviar PLANTILLAS aprobadas, así que hay que crear una
# con un parámetro de texto en el cuerpo y ponerla en WHATSAPP_TEMPLATE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=alerta_publicacion
WHATSAPP_TEMPLATE_LANG=es

# --- CORS (solo desarrollo) ----------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
